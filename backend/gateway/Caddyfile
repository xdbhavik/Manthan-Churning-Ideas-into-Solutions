# SIH26043 gateway (Caddy 2, static L7 reverse proxy).
#
# The frontends call a configurable baseUrl (default http://localhost:8080) with
# RELATIVE API paths — so the gateway contract is "same paths, one port":
# path prefixes below are forwarded verbatim, only the upstream host changes.
#
# Step 3: the evaluation pipeline is extracted to `evaluation-service` (:8083);
# everything else still lands on the monolith (`app` on :8081). Steps 4-5 will
# point the problem and source matcher groups at their own services.

:8080 {
	encode gzip

	# --- source-service route set (auth, users, source registration & accounts) ---
	@source path /auth/* /users/* /registration/* /reviewer/registrations/* /source/accounts/* /sources/*
	handle @source {
		reverse_proxy app:8081
	}

	# --- problem-service route set (domains, problems, problem-scoped audit) ---
	@problem path /domains /domains/* /problems /problems/* /audit*
	handle @problem {
		reverse_proxy app:8081
	}

	# --- evaluation-service route set ---
	@evaluation path /evaluation/*
	handle @evaluation {
		reverse_proxy evaluation-service:8083
	}

	# --- everything else (swagger-ui, /v3/api-docs, /error, OPTIONS preflight,
	#     any unclaimed prefix) still goes to the monolith at this step. ---
	handle {
		reverse_proxy app:8081
	}
}
