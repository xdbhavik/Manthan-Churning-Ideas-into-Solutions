# Keep the docker build context tiny: the thin Dockerfile.service only needs one
# pre-packaged service jar (plus this file). Everything else is excluded.
.git
**/.git
**/target/*
!source-service/target/source-service-0.0.1-SNAPSHOT.jar
!evaluation-service/target/evaluation-service-0.0.1-SNAPSHOT.jar
!problem-service/target/problem-service-0.0.1-SNAPSHOT.jar
!eureka-server/target/eureka-server-0.0.1-SNAPSHOT.jar
**/data
actor-ui
registration-wizard
test-ui
.idea
*.iml
