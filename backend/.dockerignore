# Keep the docker build context tiny: the thin Dockerfile.app only needs the
# pre-packaged app jar (plus this file). Everything else is excluded.
.git
**/.git
**/target/*
!app/target/app-0.0.1-SNAPSHOT.jar
!evaluation-service/target/evaluation-service-0.0.1-SNAPSHOT.jar
!problem-service/target/problem-service-0.0.1-SNAPSHOT.jar
**/data
actor-ui
registration-wizard
test-ui
.idea
*.iml
