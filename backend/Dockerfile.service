# Thin wrapper image, shared by every service in the reactor (eureka-server,
# source-service, problem-service, evaluation-service): it only copies a
# pre-built Spring Boot fat jar.
#
# Build it from the repo root AFTER packaging on the host:
#   ./mvnw -DskipTests package
#   docker compose up -d --build
#
# JAR_FILE has no default on purpose — each compose service names its own jar
# (see docker-compose.yml), and a missing arg should fail the build loudly
# instead of silently shipping some other service's jar.
FROM eclipse-temurin:21-jre

WORKDIR /app
ARG JAR_FILE
COPY ${JAR_FILE} /app/service.jar

# No EXPOSE: the listening port is per service (SERVER_PORT) and published by
# compose, so hardcoding one here would only mislead.
ENTRYPOINT ["java", "-jar", "/app/service.jar"]
